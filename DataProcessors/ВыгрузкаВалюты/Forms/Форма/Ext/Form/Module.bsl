КонецПроцедуры

&НаСервере
Процедура ВыгрузитьГруппыНаСервере()

	//Сделаем выборку элементов номенклатура
	ВыборкаВалюты = Справочники.Номенклатура.Выбрать();
	
	//Создать файл XML
	Файл = Новый ЗаписьXML;
	
	//Указываем путь к файлу
	Файл.ОткрытьФайл("C:\Users\Makoveev Aleksandr\Desktop\Обмен\upload_grooups.xml");
	
	//Техническая информация
	Файл.ЗаписатьОбъявлениеXML();
	
	Файл.ЗаписатьНачалоЭлемента("Root");
	
	
	Пока ВыборкаВалюты.Следующий() Цикл
		
		Если Не ВыборкаВалюты.ЭтоГруппа Тогда
		    Продолжить;
		КонецЕсли;
		
		ЭлементВыборки = ВыборкаВалюты.Ссылка;
		
		//Добавить элементы в файл
		Файл.ЗаписатьНачалоЭлемента("Номенклатура");
		
		//Добавляем атрибуты
		файл.ЗаписатьАтрибут("Код" , ВыборкаВалюты.Код);
		файл.ЗаписатьАтрибут("ЦенаЗакупки" , Строка(ВыборкаВалюты.ЦенаЗакупки));
		файл.ЗаписатьАтрибут("ЦенаРеализации" , Строка(ВыборкаВалюты.ЦенаРеализации));
		файл.ЗаписатьАтрибут("НаименованиеРодителя" , Строка(ВыборкаВалюты.Родитель.Наименование));
		
		//Если ВыборкаВалюты.ЭтоГруппа Тогда
		//
		//	ПараметрГруппы = "1";
		//Иначе
		//	ПараметрГруппы = "0";
		//КонецЕсли;
		
		файл.ЗаписатьАтрибут("ЭтоГруппа" , ?(ВыборкаВалюты.ЭтоГруппа, "1", "0"));
		
		Файл.ЗаписатьТекст(ВыборкаВалюты.Наименование);
		
		//Закрываем элемент
		файл.ЗаписатьКонецЭлемента();
		
		
	КонецЦикла; 
	
	//Закрываем корневой узел
	Файл.ЗаписатьКонецЭлемента();
	
	//Запись файла на диске
	Файл.Закрыть();

КонецПроцедуры

