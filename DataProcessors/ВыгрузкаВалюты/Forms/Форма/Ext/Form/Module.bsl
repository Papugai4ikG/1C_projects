
&НаСервереБезКонтекста
Процедура ВыгрузитьНаСервере()

	//Сделаем выборку элементов номенклатура
	ВыборкаВалюты = Справочники.Валюты.Выбрать();
	
	//Создать файл XML
	Файл = Новый ЗаписьXML;
	
	//Указываем путь к файлу
	Файл.ОткрытьФайл("C:\Users\Makoveev Aleksandr\Desktop\Обмен\upload_currency.xml");
	
	//Техническая информация
	Файл.ЗаписатьОбъявлениеXML();
	
	Файл.ЗаписатьНачалоЭлемента("Root");
	
	Пока ВыборкаВалюты.Следующий() Цикл
		
		ЭлементВыборки = ВыборкаВалюты.Ссылка;
		
		//Добавить элементы в файл
		Файл.ЗаписатьНачалоЭлемента("Валюта");
		
		//Добавляем атрибуты
		файл.ЗаписатьАтрибут("Код" , ВыборкаВалюты.Код);
		файл.ЗаписатьАтрибут("Наименование" , ВыборкаВалюты.Наименование);
		
		//Закрываем элемент
		файл.ЗаписатьКонецЭлемента();
		
		
	КонецЦикла; 
	
	//Закрываем корневой узел
	Файл.ЗаписатьКонецЭлемента();
	
	//Запись файла на диске
	Файл.Закрыть();
	
	

КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
